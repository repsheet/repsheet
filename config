ngx_addon_name=ngx_http_bot_verifier_module

ngx_feature="hiredis"
ngx_feature_name=
ngx_feature_run=no
ngx_feature_incs="#include <hiredis/hiredis.h>
#include <hiredis/async.h>"
ngx_feature_path=
ngx_feature_libs="-lhiredis"
ngx_feature_test="redisOptions o = {0}; redisAsyncContext *c = redisAsyncConnectWithOptions(&o); (void) c;"
. auto/feature

if [ $ngx_found = no ]; then
    cat << END

$0: error: ngx_bot_verifier requires hiredis >= 1.0 (headers and library).
Install libhiredis-dev / hiredis-devel, or pass its location with
--with-cc-opt="-I<prefix>/include" --with-ld-opt="-L<prefix>/lib".

END
    exit 1
fi

ngx_module_type=HTTP
ngx_module_name=ngx_http_bot_verifier_module
ngx_module_incs="$ngx_addon_dir/src"
ngx_module_deps="$ngx_addon_dir/src/ngx_http_bot_verifier.h"
ngx_module_srcs="$ngx_addon_dir/src/ngx_http_bot_verifier_module.c \
                 $ngx_addon_dir/src/ngx_http_bot_verifier_providers.c \
                 $ngx_addon_dir/src/ngx_http_bot_verifier_cache.c \
                 $ngx_addon_dir/src/ngx_http_bot_verifier_verify.c \
                 $ngx_addon_dir/src/ngx_http_bot_verifier_redis.c"
ngx_module_libs="-lhiredis"

. auto/module
