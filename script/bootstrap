#!/usr/bin/env bash
#
# Download and build the pinned development dependencies into .deps/
#
#   script/bootstrap            hiredis, Valkey, the Repsheet module, nginx
#   script/bootstrap nginx      rebuild nginx (with this module) only
#   script/bootstrap asan       sanitizer builds of Valkey, the Repsheet module and nginx
#   script/bootstrap clean      remove .deps/
#
# Environment overrides:
#   NGINX_VERSION, VALKEY_VERSION, HIREDIS_VERSION, REPSHEET_REF
#   SANITIZE=1      build nginx with ASan/UBSan
#   DYNAMIC=1       build the modules as dynamic modules
#   WITH_REPSHEET=0 build nginx without the Repsheet nginx module (default: with,
#                   so the tests cover reusing repsheet_redis)
#
# Valkey and the Repsheet module are only needed by the tests (Redis cache and
# Repsheet reporting); the module itself only needs hiredis and nginx.
#
set -euo pipefail

NGINX_VERSION="${NGINX_VERSION:-1.30.6}"
VALKEY_VERSION="${VALKEY_VERSION:-9.1.3}"
HIREDIS_VERSION="${HIREDIS_VERSION:-1.5.0}"
REPSHEET_REF="${REPSHEET_REF:-24a113ad80434271b2f67693dd48ec0aef9ef24a}"

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
DEPS="$ROOT/.deps"
SRC="$DEPS/src"
PREFIX="$DEPS/prefix"
JOBS="$(nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 4)"

log() { printf '==> %s\n' "$*"; }

fetch() { # url dest-dir
  local url="$1" dest="$2"
  if [[ -d "$dest" ]]; then return; fi
  log "fetching $url"
  mkdir -p "$SRC"
  curl -fsSL "$url" | tar xz -C "$SRC"
}

build_hiredis() {
  if [[ -f "$PREFIX/lib/libhiredis.a" ]]; then return; fi
  fetch "https://github.com/redis/hiredis/archive/refs/tags/v${HIREDIS_VERSION}.tar.gz" \
    "$SRC/hiredis-${HIREDIS_VERSION}"
  log "building hiredis ${HIREDIS_VERSION}"
  make -C "$SRC/hiredis-${HIREDIS_VERSION}" -j"$JOBS" \
    PREFIX="$PREFIX" CFLAGS="-fPIC -O2 -g" USE_SSL=0 install >/dev/null
  # Link statically so nginx does not need hiredis at runtime in development.
  rm -f "$PREFIX"/lib/libhiredis*.so*
}

build_valkey() {
  if [[ -x "$PREFIX/bin/valkey-server" ]]; then return; fi
  fetch "https://github.com/valkey-io/valkey/archive/refs/tags/${VALKEY_VERSION}.tar.gz" \
    "$SRC/valkey-${VALKEY_VERSION}"
  log "building valkey ${VALKEY_VERSION} (takes a minute)"
  make -C "$SRC/valkey-${VALKEY_VERSION}" -j"$JOBS" BUILD_TLS=no >/dev/null
  make -C "$SRC/valkey-${VALKEY_VERSION}" PREFIX="$PREFIX" install >/dev/null
}

# Valkey built with ASan, so a sanitized Repsheet module can be loaded.
build_valkey_asan() {
  if [[ -x "$DEPS/asan/bin/valkey-server" ]]; then return; fi
  fetch "https://github.com/valkey-io/valkey/archive/refs/tags/${VALKEY_VERSION}.tar.gz" \
    "$SRC/valkey-${VALKEY_VERSION}"
  log "building valkey ${VALKEY_VERSION} with ASan"
  rm -rf "$SRC/valkey-asan" && cp -r "$SRC/valkey-${VALKEY_VERSION}" "$SRC/valkey-asan"
  make -C "$SRC/valkey-asan" distclean >/dev/null 2>&1 || true
  make -C "$SRC/valkey-asan" -j"$JOBS" BUILD_TLS=no SANITIZER=address MALLOC=libc >/dev/null
  make -C "$SRC/valkey-asan" PREFIX="$DEPS/asan" install >/dev/null
}

# The Repsheet Valkey/Redis module, for the bot_verifier_repsheet tests.
build_repsheet() {
  local flavor="${1:-}" out="$PREFIX/lib/repsheet.so" sanitize=0
  if [[ "$flavor" == asan ]]; then out="$DEPS/asan/lib/repsheet.so"; sanitize=1; fi
  if [[ -f "$out" ]]; then return; fi
  fetch "https://github.com/repsheet/repsheet/archive/${REPSHEET_REF}.tar.gz" "$SRC/repsheet-${REPSHEET_REF}"
  log "building the repsheet module (${REPSHEET_REF:0:7})"
  make -C "$SRC/repsheet-${REPSHEET_REF}/redis" clean all SANITIZE="$sanitize" >/dev/null
  mkdir -p "$(dirname "$out")"
  cp "$SRC/repsheet-${REPSHEET_REF}/redis/repsheet.so" "$out"
}

build_nginx() {
  fetch "https://nginx.org/download/nginx-${NGINX_VERSION}.tar.gz" "$SRC/nginx-${NGINX_VERSION}"
  log "building nginx ${NGINX_VERSION} with ngx_bot_verifier${WITH_REPSHEET:+ (repsheet: ${WITH_REPSHEET})}"

  local cc_opt="-g -O1 -Wall -Wextra -Wno-unused-parameter -Werror -I$PREFIX/include"
  local ld_opt="-L$PREFIX/lib"
  if [[ "${SANITIZE:-0}" == 1 ]]; then
    cc_opt="$cc_opt -fsanitize=address,undefined -fno-omit-frame-pointer"
    ld_opt="$ld_opt -fsanitize=address,undefined"
  fi

  local flag="--add-module"
  [[ "${DYNAMIC:-0}" == 1 ]] && flag="--add-dynamic-module"
  local modules=("$flag=$ROOT")
  if [[ "${WITH_REPSHEET:-1}" == 1 ]]; then
    fetch "https://github.com/repsheet/repsheet/archive/${REPSHEET_REF}.tar.gz" "$SRC/repsheet-${REPSHEET_REF}"
    modules+=("$flag=$SRC/repsheet-${REPSHEET_REF}/nginx")
  fi

  (
    cd "$SRC/nginx-${NGINX_VERSION}"
    ./configure \
      --prefix="$DEPS/nginx" \
      --with-debug \
      --with-http_realip_module \
      --with-cc-opt="$cc_opt" \
      --with-ld-opt="$ld_opt" \
      "${modules[@]}" >/dev/null
    make -j"$JOBS" >/dev/null
    make install >/dev/null
  )
  log "nginx installed at $DEPS/nginx/sbin/nginx"
}

case "${1:-all}" in
  all)    build_hiredis; build_valkey; build_repsheet; build_nginx ;;
  asan)   build_hiredis; build_valkey_asan; build_repsheet asan; SANITIZE=1 build_nginx ;;
  deps)   build_hiredis; build_valkey; build_repsheet ;;
  nginx)  build_nginx ;;
  clean)  rm -rf "$DEPS" ;;
  *)      echo "usage: $0 [all|deps|nginx|asan|clean]" >&2; exit 1 ;;
esac
