ngx_addon_name=ngx_http_repsheet_module

REPSHEET_COMMON="$ngx_addon_dir/../common"

ngx_feature="hiredis"
ngx_feature_name=
ngx_feature_run=no
ngx_feature_incs="#include <hiredis/hiredis.h>
#include <hiredis/async.h>"
ngx_feature_path=
ngx_feature_libs="-lhiredis"
ngx_feature_test="redisOptions o = {0}; redisAsyncContext *c = redisAsyncConnectWithOptions(&o); (void) c;"
. auto/feature

if [ $ngx_found = no ]; then
    cat << END

$0: error: the repsheet module requires hiredis >= 1.0 (headers and library).
Install libhiredis-dev / hiredis-devel, or pass its location with
--with-cc-opt="-I<prefix>/include" --with-ld-opt="-L<prefix>/lib".

END
    exit 1
fi

ngx_module_type=HTTP
# One addon, two module objects: the repsheet module and its bot verifier
# detector (which is off unless repsheet_bot_verifier is on).
ngx_module_name="ngx_http_repsheet_module ngx_http_repsheet_bot_verifier_module"
ngx_module_incs="$ngx_addon_dir/src $REPSHEET_COMMON"
ngx_module_deps="$ngx_addon_dir/src/ngx_http_repsheet_module.h \
                 $ngx_addon_dir/src/ngx_http_repsheet_public.h \
                 $ngx_addon_dir/src/ngx_http_repsheet_redis.h \
                 $ngx_addon_dir/src/bot_verifier/ngx_http_repsheet_bv.h \
                 $REPSHEET_COMMON/repsheet_actor.h"
ngx_module_srcs="$ngx_addon_dir/src/ngx_http_repsheet_module.c \
                 $ngx_addon_dir/src/ngx_http_repsheet_store.c \
                 $ngx_addon_dir/src/ngx_http_repsheet_sync.c \
                 $ngx_addon_dir/src/ngx_http_repsheet_redis.c \
                 $ngx_addon_dir/src/bot_verifier/ngx_http_repsheet_bv_module.c \
                 $ngx_addon_dir/src/bot_verifier/ngx_http_repsheet_bv_providers.c \
                 $ngx_addon_dir/src/bot_verifier/ngx_http_repsheet_bv_cache.c \
                 $ngx_addon_dir/src/bot_verifier/ngx_http_repsheet_bv_verify.c \
                 $REPSHEET_COMMON/repsheet_actor.c"
ngx_module_libs="-lhiredis"

. auto/module
